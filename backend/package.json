{
  "name": "carbonbox-backend",
  "version": "1.0.0",
  "private": true,
  "description": "API y worker de procesamiento asíncrono de CSV (DDD + Clean Architecture + CQRS)",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/main/index.ts",
    "worker": "tsx src/workers/FileProcessingWorker.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main/index.js",
    "start:worker": "node dist/workers/FileProcessingWorker.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "prisma": {
    "schema": "src/document-processing/infrastructure/persistence/models/schema.prisma"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "3.1149.0",
    "@fastify/cors": "11.3.1",
    "@fastify/multipart": "9.4.0",
    "@prisma/client": "6.19.3",
    "awilix": "12.1.1",
    "convict": "6.2.5",
    "csv-parse": "5.6.0",
    "dotenv": "16.6.1",
    "fastify": "5.12.5",
    "pino": "9.14.0",
    "prisma": "6.19.3",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/convict": "6.1.6",
    "@types/node": "22.20.5",
    "eslint": "9.39.5",
    "pino-pretty": "13.2.0",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1",
    "vitest": "3.2.7"
  }
}
