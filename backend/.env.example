# Copiar a .env (desarrollo). Prisma CLI y la app leen este archivo.
NODE_ENV=development
PORT=3001
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/document_processing?schema=public
DEFAULT_USER_ID=user-123
MAX_FILE_SIZE_MB=10
STORAGE_DIR=./uploads
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local
SQS_ENDPOINT=http://localhost:9324
SQS_QUEUE_URL=http://localhost:9324/000000000000/file-processing
SQS_MAX_RECEIVE_COUNT=3
SQS_WAIT_TIME_SECONDS=10
SQS_RETRY_BASE_DELAY_SECONDS=10
SQS_RETRY_BACKOFF_FACTOR=4
SQS_RETRY_MAX_DELAY_SECONDS=300
